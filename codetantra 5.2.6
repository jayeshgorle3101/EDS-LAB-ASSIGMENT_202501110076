import pandas as pd
import matplotlib.pyplot as plt

# Load the Titanic dataset
data = pd.read_csv('Titanic-Dataset.csv')

# Data Cleaning
data['Age'].fillna(data['Age'].median(), inplace=True)
data['Embarked'].fillna(data['Embarked'].mode()[0], inplace=True)
data.drop('Cabin', axis=1, inplace=True)

# Convert categorical features to numeric
data['Sex'] = data['Sex'].map({'male': 0, 'female': 1})
data = pd.get_dummies(data, columns=['Embarked'], drop_first=True)

# Write your code here for Bar Plot for Survival by Embarked

# Group data based on Embarked_Q and Survived
grouped_data = data.groupby('Embarked_Q')['Survived'].value_counts().unstack().fillna(0)

# Ensure correct column order (0 = Not Survived, 1 = Survived)
grouped_data = grouped_data[[0, 1]]

# Plot stacked bar chart
grouped_data.plot(kind='bar', stacked=True)

# Labels and title
plt.title("Survival by Embarked")
plt.xlabel("Embarked")
plt.ylabel("Count")

# Legend (match exact output)
plt.legend(['Not Survived', 'Survived'])

# Display plot
plt.show()

